{
  "$schema": "https://raw.githubusercontent.com/sebas-tcotd/vellum/main/packages/theme-engine/vellumstyle.schema.json",
  "schemaVersion": 1,
  "name": "My complete theme",
  "mapBackground": "#ede5d2",
  "mapFrame": "#e5dcc8",
  "terrain": {
    "base": "#ede5d2",
    "low": "#aaae86",
    "mid": "#d9d1b8",
    "high": "#c3af8d"
  },
  "contourLine": "#aa9e86",
  "water": "#86b0b0",
  "forests": "#5f7f4f",
  "transitBackground": "#3b4050",
  "roads": {
    "highway": {
      "generic": {
        "fill": "#c0532c",
        "casing": "#6e2a15"
      }
    },
    "largeArterial": {
      "generic": {
        "fill": "#d9a24a",
        "casing": "#7f5a22"
      }
    },
    "mediumArterial": {
      "generic": {
        "fill": "#ead39c",
        "casing": "#8f7457"
      }
    },
    "local": {
      "generic": {
        "fill": "#f5eedf",
        "casing": "#8f7b62"
      },
      "gravel": {
        "fill": "#cdbd9b",
        "casing": "#9e896e"
      }
    },
    "pedestrian": {
      "path": {
        "fill": "#9e8870",
        "casing": "#796650"
      },
      "way": {
        "fill": "#b2a088",
        "casing": "#8e7962"
      },
      "street": {
        "fill": "#9e8870",
        "casing": "#796650"
      }
    },
    "rail": {
      "train": {
        "fill": "#efe8d8",
        "casing": "#4a4035"
      },
      "metro": {
        "fill": "#efe8d8",
        "casing": "#66718f"
      }
    },
    "ferry": {
      "fill": "#638f91",
      "casing": "#638f91"
    }
  },
  "buildings": {
    "residential": {
      "low": {
        "fill": "#ecd2c4",
        "stroke": "#86594a"
      },
      "high": {
        "fill": "#e0bba9",
        "stroke": "#7a4e3f"
      },
      "selfSufficient": {
        "fill": "#d6e0c4",
        "stroke": "#5e6f4c"
      }
    },
    "commercial": {
      "low": {
        "fill": "#ddd3e8",
        "stroke": "#665a7e"
      },
      "high": {
        "fill": "#cbbedb",
        "stroke": "#5a4c72"
      },
      "leisure": {
        "fill": "#e6cfe0",
        "stroke": "#7a5670"
      },
      "tourism": {
        "fill": "#efd6bc",
        "stroke": "#86644a"
      },
      "organic": {
        "fill": "#d2e0c4",
        "stroke": "#5c6e4a"
      }
    },
    "office": {
      "generic": {
        "fill": "#cfdfe6",
        "stroke": "#55717d"
      },
      "tech": {
        "fill": "#bed3dd",
        "stroke": "#4c6876"
      },
      "financial": {
        "fill": "#b1c6d2",
        "stroke": "#44606e"
      }
    },
    "industry": {
      "generic": {
        "fill": "#ead9a6",
        "stroke": "#7d6a36"
      },
      "forestry": {
        "fill": "#d3dcb6",
        "stroke": "#606c40"
      },
      "ore": {
        "fill": "#dcc8b4",
        "stroke": "#735c45"
      },
      "oil": {
        "fill": "#d3cfc4",
        "stroke": "#605b4f"
      },
      "farming": {
        "fill": "#e6dcae",
        "stroke": "#76693a"
      }
    },
    "civic": {
      "publicTransport": {
        "fill": "#c8dedb",
        "stroke": "#4f6f6b"
      },
      "education": {
        "fill": "#d3e1cf",
        "stroke": "#566c52"
      },
      "services": {
        "fill": "#d8d4e2",
        "stroke": "#5f5a74"
      }
    },
    "none": {
      "fill": "#e8cbbb",
      "stroke": "#7f5446"
    }
  },
  "districts": {
    "fill": "#b49b68",
    "label": "#5b5043"
  },
  "grid": {
    "color": "#7d705f",
    "opacity": 0.18,
    "width": 1,
    "dasharray": [4, 4]
  },
  "parkAreas": {
    "generic": "#aeb58f",
    "university": "#c5b58c",
    "tradeSchool": "#b99480",
    "industry": "#9b8b9f",
    "forestry": "#8f9c7f"
  },
  "transferMarker": {
    "fill": "#d9a441",
    "stroke": "#8a5a1f"
  },
  "roadLabels": {
    "color": "#3f3529"
  }
}

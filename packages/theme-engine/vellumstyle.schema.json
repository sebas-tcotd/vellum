                }
              },
              "required": ["fill", "casing"]
            },
            "metro": {
              "type": "object",
              "properties": {
                "fill": {
                  "$ref": "#/$defs/colorToken",
                  "default": "#eceff1"
                },
                "casing": {
                  "$ref": "#/$defs/colorToken",
                  "default": "#e4572e"
                }

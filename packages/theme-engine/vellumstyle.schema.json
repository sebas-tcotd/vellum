            "casing": {
              "$ref": "#/$defs/colorToken",
              "default": "#1A5276"
            }
          },
          "required": ["fill", "casing"]
        }
      },
      "required": [
        "highway",
        "largeArterial",
        "mediumArterial",
        "local",
        "pedestrian",
        "rail",
        "ferry"
      ]
    },

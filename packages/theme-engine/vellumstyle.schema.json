                  "default": "#c8bfb5"
                },
                "stroke": {
                  "$ref": "#/$defs/colorToken",
                  "default": "#a09585"
                }
              },
              "required": ["fill", "stroke"]
            },
            "tourism": {
              "type": "object",
              "properties": {
                "fill": {
                  "$ref": "#/$defs/colorToken",
                  "default": "#c8bfb5"
                },
                "stroke": {

                  "default": "#c8bfb5"
                },
                "stroke": {
                  "$ref": "#/$defs/colorToken",
                  "default": "#a09585"
                }
              },
              "required": ["fill", "stroke"]
            },
            "high": {
              "type": "object",
              "properties": {
                "fill": {
                  "$ref": "#/$defs/colorToken",
                  "default": "#c8bfb5"
                },
                "stroke": {
                  "$ref": "#/$defs/colorToken",
                  "default": "#a09585"
                }
              },
              "required": ["fill", "stroke"]
            },
            "selfSufficient": {
              "type": "object",
              "properties": {
                "fill": {
                  "$ref": "#/$defs/colorToken",
                  "default": "#c8bfb5"
                },
                "stroke": {
                  "$ref": "#/$defs/colorToken",
                  "default": "#a09585"
                }
              },
              "required": ["fill", "stroke"]
            }
          },
          "required": ["low", "high", "selfSufficient"]
        },
        "commercial": {
          "type": "object",
          "properties": {
            "low": {
              "type": "object",
              "properties": {
                "fill": {
                  "$ref": "#/$defs/colorToken",
                  "default": "#c8bfb5"
                },
                "stroke": {
                  "$ref": "#/$defs/colorToken",
                  "default": "#a09585"
                }
              },

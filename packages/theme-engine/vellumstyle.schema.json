          "required": ["generic", "gravel"]
        },
        "pedestrian": {
          "type": "object",
          "properties": {
            "path": {
              "type": "object",
              "properties": {
                "fill": {
                  "$ref": "#/$defs/colorToken",
                  "default": "#7a6e60"
                },
                "casing": {
                  "$ref": "#/$defs/colorToken",
                  "default": "#5d5550"
                }
              },
              "required": ["fill", "casing"]
            },
            "way": {
              "type": "object",
              "properties": {
                "fill": {
                  "$ref": "#/$defs/colorToken",
                  "default": "#8b7d6b"
                },
                "casing": {
                  "$ref": "#/$defs/colorToken",
                  "default": "#8b7d6b"
                }

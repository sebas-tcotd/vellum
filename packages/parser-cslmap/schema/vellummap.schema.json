{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sebas-tcotd/vellum/main/packages/parser-cslmap/schema/vellummap.schema.json",
  "title": "Vellum .vellummap document",
  "description": "Contract of Vellum's stable city document. A .vellummap is a zip with a manifest.json (validated by this root schema) and one entry per module. JSON modules are validated by the $defs of the same name; grid modules are raw little-endian samples whose shape the manifest declares and the reader verifies. Unknown properties are rejected at every level. See docs/es/vellummap-format.md.",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "sourceId": {
      "description": "ID of the element in Cities: Skylines 1 (a buffer index the game reuses: not a stable identity on its own). The reader rejects numbers written with a fraction (1.0), which JSON Schema's integer type accepts. Unique within its collection (reader-only rule).",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "version": {
      "description": "MAJOR.MINOR. This reader supports major 1 only; any minor is accepted.",
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "position": {
      "description": "World-space position in game units: x/z horizontal (−8640…8640), y vertical.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "grid": {
      "description": "Shape of a grid module: resolution² samples, row-major. Fixed per module in v1.",
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "cellSize", "sample"],
      "properties": {
        "resolution": {
          "type": "integer",
          "minimum": 1
        },
        "cellSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sample": {
          "enum": ["u8", "u16le", "u8x8"]
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Metres per raw unit."
        }
      }
    },
    "moduleEntry": {
      "description": "One module of the document. `path` and `grid` are fixed by `id`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "version", "codec", "sha256"],
      "properties": {
        "id": {
          "enum": [
            "terrain",
            "water",
            "water-mask",
            "water-depth",
            "vegetation",
            "roads",
            "transit",
            "buildings",
            "districts",
            "parks",
            "district-grid",
            "park-grid"
          ],
          "description": "terrain (terrain.bin): RawHeights2 (visible terrain), u16 little-endian raw units; metres = raw × scale.; water (water.json): Sea level and, when water-depth.bin is present, its provenance.; water-mask (water-mask.bin): Stable water contract: 1 = wet (depth > 16 raw units = 25 cm), 0 = dry.; water-depth (water-depth.bin, optional): Optional water depth (WaterSimulation.Cell.m_height), u16 little-endian raw units.; vegetation (vegetation.bin): NaturalResourceManager.m_tree density, 0–255.; roads (roads.json): Road nodes and segments.; transit (transit.json): Transit lines, stops and routes.; buildings (buildings.json): Buildings with their footprints.; districts (districts.json): Districts and their label anchors.; parks (parks.json): Park areas (DLC) and their label anchors.; district-grid (districts.bin, optional): Optional district cells: per cell 4 district ids then their 4 alphas.; park-grid (parks.bin, optional): Optional park cells: per cell 4 park ids then their 4 alphas."
        },
        "path": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "codec": {
          "enum": ["deflate", "stored"],
          "description": "Must match the zip entry's real compression method."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hex SHA-256 of the entry's decompressed bytes."
        },
        "grid": {
          "$ref": "#/$defs/grid"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "const": "terrain"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "terrain.bin"
              },
              "grid": {
                "const": {
                  "resolution": 1081,
                  "cellSize": 16,
                  "sample": "u16le",
                  "scale": 0.015625
                }
              }
            },
            "required": ["grid"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "const": "water"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "water.json"
              }
            },
            "not": {
              "type": "object",
              "required": ["grid"]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "const": "water-mask"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "water-mask.bin"
              },
              "grid": {
                "const": {
                  "resolution": 1081,
                  "cellSize": 16,
                  "sample": "u8"
                }
              }
            },
            "required": ["grid"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "const": "water-depth"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "water-depth.bin"
              },
              "grid": {
                "const": {
                  "resolution": 1081,
                  "cellSize": 16,
                  "sample": "u16le",
                  "scale": 0.015625
                }
              }
            },
            "required": ["grid"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "const": "vegetation"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "vegetation.bin"
              },
              "grid": {
                "const": {
                  "resolution": 512,
                  "cellSize": 33.75,
                  "sample": "u8"
                }
              }
            },
            "required": ["grid"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "const": "roads"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "roads.json"
              }
            },
            "not": {
              "type": "object",
              "required": ["grid"]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "const": "transit"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "transit.json"
              }
            },
            "not": {
              "type": "object",
              "required": ["grid"]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "const": "buildings"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "buildings.json"
              }
            },
            "not": {
              "type": "object",
              "required": ["grid"]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "const": "districts"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "districts.json"
              }
            },
            "not": {
              "type": "object",
              "required": ["grid"]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "const": "parks"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "parks.json"
              }
            },
            "not": {
              "type": "object",
              "required": ["grid"]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "const": "district-grid"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "districts.bin"
              },
              "grid": {
                "const": {
                  "resolution": 900,
                  "cellSize": 19.2,
                  "sample": "u8x8"
                }
              }
            },
            "required": ["grid"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "const": "park-grid"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "parks.bin"
              },
              "grid": {
                "const": {
                  "resolution": 900,
                  "cellSize": 19.2,
                  "sample": "u8x8"
                }
              }
            },
            "required": ["grid"]
          }
        }
      ]
    },
    "manifest": {
      "description": "manifest.json",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "exportSchemaVersion",
        "snapshotId",
        "exportedAtUtc",
        "game",
        "producer",
        "city",
        "modules"
      ],
      "properties": {
        "format": {
          "const": "vellummap"
        },
        "exportSchemaVersion": {
          "$ref": "#/$defs/version"
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "description": "Unique ID of this export (a UUID for Bridge)."
        },
        "parentSnapshotId": {
          "type": "string",
          "minLength": 1,
          "description": "Optional. snapshotId this export descends from, to represent history branches."
        },
        "exportedAtUtc": {
          "description": "When the file was exported: RFC 3339 in UTC with an uppercase `T` and a `Z` suffix, no offset (e.g. 2026-06-10T17:35:58Z). Vellum shows it as the city's generation date. The reader also checks that the day exists in its month (reader-only rule).",
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?Z$"
        },
        "gameTime": {
          "type": "string",
          "minLength": 1,
          "description": "Optional. In-game date (SimulationManager.m_currentGameTime). Not a reliable order."
        },
        "game": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "description": "Game version, or \"unknown\" when the source does not record it."
            },
            "instanceId": {
              "type": "string",
              "minLength": 1,
              "description": "Optional. m_metaData.m_gameInstanceIdentifier (a GUID some mods regenerate)."
            }
          }
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "city": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string"
            }
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/moduleEntry"
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "terrain"
                  }
                },
                "required": ["id"]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "water"
                  }
                },
                "required": ["id"]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "water-mask"
                  }
                },
                "required": ["id"]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "vegetation"
                  }
                },
                "required": ["id"]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "roads"
                  }
                },
                "required": ["id"]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "transit"
                  }
                },
                "required": ["id"]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "buildings"
                  }
                },
                "required": ["id"]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "districts"
                  }
                },
                "required": ["id"]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "parks"
                  }
                },
                "required": ["id"]
              }
            }
          ]
        }
      }
    },
    "water": {
      "description": "water.json",
      "type": "object",
      "additionalProperties": false,
      "required": ["seaLevel"],
      "properties": {
        "seaLevel": {
          "type": "number",
          "description": "Sea level in metres (a scalar of the game, not a water source)."
        },
        "depth": {
          "description": "Provenance of water-depth.bin. Present exactly when that module is.",
          "type": "object",
          "additionalProperties": false,
          "required": ["simulationPaused"],
          "properties": {
            "simulationPaused": {
              "type": "boolean",
              "description": "Whether the water simulation was paused at capture."
            },
            "frameIndex": {
              "type": "integer",
              "minimum": 0,
              "description": "Optional. Water simulation frame at capture. At most 2^53 − 1 (the largest integer JSON consumers represent exactly). The reader also rejects numbers written with a fraction (1.0).",
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "roads": {
      "description": "roads.json",
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "segments"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId", "position", "elevation", "underground"],
            "properties": {
              "sourceId": {
                "$ref": "#/$defs/sourceId"
              },
              "position": {
                "$ref": "#/$defs/position"
              },
              "elevation": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255,
                "description": "NetNode.m_elevation."
              },
              "underground": {
                "type": "boolean",
                "description": "NetNode.Flags.Underground."
              }
            }
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "startNodeSourceId",
              "endNodeSourceId",
              "itemClass",
              "width",
              "points"
            ],
            "properties": {
              "sourceId": {
                "$ref": "#/$defs/sourceId"
              },
              "startNodeSourceId": {
                "$ref": "#/$defs/sourceId"
              },
              "endNodeSourceId": {
                "$ref": "#/$defs/sourceId"
              },
              "itemClass": {
                "type": "string",
                "description": "The network prefab's ItemClass name: source of truth for classification."
              },
              "width": {
                "type": "number",
                "minimum": 0
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Visible street name (NetManager.GetSegmentName). Absent for unnamed networks."
              },
              "points": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/position"
                },
                "description": "Curve points, start to end."
              }
            }
          }
        }
      }
    },
    "transit": {
      "description": "transit.json",
      "type": "object",
      "additionalProperties": false,
      "required": ["lines"],
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "name",
              "transportType",
              "color",
              "stops",
              "route"
            ],
            "properties": {
              "sourceId": {
                "$ref": "#/$defs/sourceId"
              },
              "name": {
                "type": "string",
                "description": "GetLineName."
              },
              "transportType": {
                "type": "string",
                "description": "TransportInfo.TransportType name (Bus, Metro, Ship, …)."
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-F]{8}$",
                "description": "Visible line color (displayColor), #RRGGBBAA uppercase."
              },
              "stops": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sourceId", "position"],
                  "dependentRequired": {
                    "nameDerived": ["name"]
                  },
                  "properties": {
                    "sourceId": {
                      "$ref": "#/$defs/sourceId",
                      "description": "sourceId of the stop's node."
                    },
                    "position": {
                      "$ref": "#/$defs/position"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Optional. Absent when the stop has no name."
                    },
                    "nameDerived": {
                      "type": "boolean",
                      "description": "Optional. true when name was derived from the street (<street> or <street> N)."
                    }
                  }
                }
              },
              "route": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/sourceId"
                },
                "description": "Segment sourceIds of the whole route, in travel order."
              }
            }
          }
        }
      }
    },
    "buildings": {
      "description": "buildings.json",
      "type": "object",
      "additionalProperties": false,
      "required": ["buildings"],
      "properties": {
        "buildings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "name",
              "itemClass",
              "serviceType",
              "footprint"
            ],
            "properties": {
              "sourceId": {
                "$ref": "#/$defs/sourceId"
              },
              "name": {
                "type": "string",
                "description": "Prefab (asset) name."
              },
              "itemClass": {
                "type": "string"
              },
              "serviceType": {
                "type": "string",
                "description": "Prefab sub-service (ResidentialLow, …)."
              },
              "footprint": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/position"
                },
                "description": "Footprint polygon; its first point is the anchor."
              }
            }
          }
        }
      }
    },
    "districts": {
      "description": "districts.json",
      "type": "object",
      "additionalProperties": false,
      "required": ["districts"],
      "properties": {
        "districts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId", "name", "labelPosition"],
            "properties": {
              "sourceId": {
                "$ref": "#/$defs/sourceId"
              },
              "name": {
                "type": "string"
              },
              "labelPosition": {
                "$ref": "#/$defs/position"
              }
            }
          }
        }
      }
    },
    "parks": {
      "description": "parks.json",
      "type": "object",
      "additionalProperties": false,
      "required": ["parks"],
      "properties": {
        "parks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId", "name", "labelPosition"],
            "properties": {
              "sourceId": {
                "$ref": "#/$defs/sourceId"
              },
              "name": {
                "type": "string"
              },
              "labelPosition": {
                "$ref": "#/$defs/position"
              },
              "parkType": {
                "type": "string",
                "minLength": 1,
                "description": "Optional. The game's park type name (Generic, Zoo, Airport, …), unreduced."
              }
            }
          }
        }
      }
    }
  }
}

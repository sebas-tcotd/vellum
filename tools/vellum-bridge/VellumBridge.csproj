<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>VellumBridge</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <!-- Versión de ensamblado nueva en cada compilación (build = días desde 2000, revisión =
         segundos/2 desde medianoche): Mono no descarga un ensamblado ya cargado y resuelve el
         mismo nombre+versión al viejo, así que sin esto CS1 no recarga el mod sin reiniciar.
         La versión visible de Bridge es BridgeCapture.Version. -->
    <AssemblyVersion>1.0.*</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>false</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <!-- El harness de pruebas (tests/) es otro proyecto: enlaza solo el escritor puro. -->
    <Compile Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ICities"><HintPath>$(CS1_MANAGED_DIR)/ICities.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(CS1_MANAGED_DIR)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ColossalManaged"><HintPath>$(CS1_MANAGED_DIR)/ColossalManaged.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(CS1_MANAGED_DIR)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CS1_MANAGED_DIR)' == ''" Text="Define CS1_MANAGED_DIR con la carpeta Managed de Cities: Skylines 1." />
    <Error Condition="!Exists('$(CS1_MANAGED_DIR)/ICities.dll')" Text="No se encuentra ICities.dll en CS1_MANAGED_DIR." />
  </Target>
</Project>

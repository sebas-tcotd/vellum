{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vellum",
  "version": "0.2.6",
  "identifier": "com.vellum.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vellum",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5M0E5RDFDOUQ5NkVGMzgKUldRNDc1YWRISjA2T1VOK0JMVG9zeUkzMWtvYStuYlpQbE5hMHFZV2FSTzZHSWxFVllCNFRUV0EK",
      "endpoints": [
        "https://github.com/sebas-tcotd/vellum/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "resources/themes/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "files": {
        "Resources/Assets.car": "icons/iconcomposer/Assets.car"
      }
    },
    "windows": {
      "wix": {
        "fragmentPaths": [
          "windows/cslmap-association.wxs"
        ],
        "featureRefs": [
          "CslmapAssociationFeature"
        ]
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vellum",
  "version": "0.6.0",
  "identifier": "com.vellum.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Vellum",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' data:; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' blob: http://localhost:1420; style-src 'self' 'unsafe-inline' http://localhost:1420; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' data: http://localhost:1420 ws://localhost:1420 ws://localhost:1421; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5M0E5RDFDOUQ5NkVGMzgKUldRNDc1YWRISjA2T1VOK0JMVG9zeUkzMWtvYStuYlpQbE5hMHFZV2FSTzZHSWxFVllCNFRUV0EK",
      "endpoints": [
        "https://github.com/sebas-tcotd/vellum/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "Sebastian Enrique Vargas Pizango",
    "homepage": "https://github.com/sebas-tcotd/vellum",
    "copyright": "Copyright (c) 2026 Sebastian Enrique Vargas Pizango",
    "license": "MIT",
    "category": "GraphicsAndDesign",
    "shortDescription": "Turn Cities: Skylines saves into printable maps.",
    "longDescription": "Vellum is an offline desktop application that reads a Cities: Skylines .cslmap export and draws it as a cartographic map you can style and export to PNG or SVG. It works entirely on your machine: no account, no telemetry, and the only network request it ever makes is the update check you can turn off.",
    "resources": [
      "resources/themes/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "10.15",
      "files": {
        "Resources/Assets.car": "icons/iconcomposer/Assets.car"
      },
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 200
        }
      }
    },
    "linux": {
      "deb": {
        "section": "graphics",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "desktopTemplate": "linux/vellum.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/vellum.desktop"
      }
    },
    "windows": {
      "wix": {
        "language": [
          "en-US",
          "es-ES"
        ],
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp",
        "fragmentPaths": [
          "windows/cslmap-association.wxs"
        ],
        "featureRefs": [
          "CslmapAssociationFeature"
        ]
      },
      "nsis": {
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}

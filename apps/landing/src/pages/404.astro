---
import BaseLayout from '../layouts/BaseLayout.astro';

const home = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Page not found | Vellum"
  description="This page is not on the Vellum map."
  noindex
>
  <main class="not-found" id="main-content">
    <p class="not-found-code">404</p>
    <h1>This place isn't on the map.</h1>
    <p>The page you asked for doesn't exist, or it moved.</p>
    <a class="not-found-home" href={home}>Back to the Vellum home</a>
  </main>
</BaseLayout>

<style>
  .not-found {
    box-sizing: border-box;
    display: grid;
    min-height: 100vh;
    align-content: center;
    gap: 1rem;
    max-width: 40rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .not-found-code {
    margin: 0;
    font-family: var(--font-mono);
    color: var(--muted);
  }

  h1 {
    max-width: none;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 500;
    line-height: 1.05;
  }

  p {
    margin: 0;
  }

  .not-found-home {
    justify-self: start;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>

---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '../styles.css';
import SeoHead, { type Alternates } from '../components/site/SeoHead.astro';

/** Props of the pages that still use the pre-v1.0 design (privacy, 404). */
interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Set only when the page exists in both languages. */
  alternates?: Alternates;
  /** Pages that must not be indexed (the 404) skip the canonical link. */
  noindex?: boolean;
}

const lang = Astro.currentLocale ?? 'en';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <SeoHead {...Astro.props} />
    <meta name="theme-color" content="#f7f6f1" />
  </head>
  <body>
    <slot />
  </body>
</html>

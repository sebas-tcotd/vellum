{
  "name": "@vellum/landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @vellum/core build && astro dev",
    "build": "pnpm --filter @vellum/core build && astro build",
    "lint": "pnpm --filter @vellum/core build && astro check && tsc --noEmit -p tsconfig.json",
    "preview": "astro preview",
    "test:static": "playwright test",
    "prespike:build": "pnpm --filter @vellum/core build",
    "spike:build": "astro build --config astro.spike.config.mjs",
    "test:spike": "playwright test --config playwright.spike.config.mjs",
    "shots:report": "node --experimental-strip-types --no-warnings scripts/shots-report.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vellum/core": "workspace:*",
    "@vellum/ui": "workspace:*",
    "i18next": "^26.4.2",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^7.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "lucide-react": "^1.43.0",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3"
  }
}

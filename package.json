{
  "name": "vellum-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test && pnpm test:scripts",
    "test:scripts": "vitest run --config vitest.scripts.config.mjs",
    "test:e2e": "turbo test:e2e",
    "lint": "turbo lint && pnpm lint:arch",
    "lint:arch": "eslint packages apps",
    "check:architecture": "pnpm lint:arch",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:lint": "cargo clippy --workspace -- -D warnings",
    "rust:test": "cargo test --workspace",
    "release:verify": "node scripts/verify-release-config.mjs",
    "brand:build": "node scripts/build-brand-assets.mjs",
    "check:installer": "node scripts/verify-installer-identity.mjs",
    "check:network": "node scripts/verify-network-surface.mjs",
    "package:windows-bootstrap": "node scripts/package-windows-bootstrap.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,md,css,scss,html,yaml,yml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,md,css,scss,html,yaml,yml}\" --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@resvg/resvg-js": "2.6.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "turbo": "2.9.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}

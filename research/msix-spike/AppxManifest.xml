<?xml version="1.0" encoding="utf-8"?>
<!--
  Spike 6.2 — prototipo descartable de MSIX. No es un target de producción.

  Manifiesto mínimo de desktop bridge (runFullTrust) para el vellum.exe de
  release. build.ps1 lo copia al layout y comprueba que Version y Publisher
  coincidan con apps/desktop/src-tauri/tauri.conf.json.

  - Identity Name es de prueba: la Store asigna el nombre y el Publisher
    reales (CN=<GUID del Partner Center>) al reservar el nombre de la app.
  - Publisher tiene que ser idéntico al Subject del certificado que firma.
  - La asociación .cslmap pasa el path como "%1"; startup.rs lo toma de argv.
    uap3:FileTypeAssociation extiende uap:FileTypeAssociation con Parameters.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity
    Name="VellumSpike.Vellum"
    Publisher="CN=Sebastian Enrique Vargas Pizango"
    Version="0.11.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Vellum</DisplayName>
    <PublisherDisplayName>Sebastian Enrique Vargas Pizango</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Turn Cities: Skylines saves into printable maps.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Vellum" Executable="vellum.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Vellum"
        Description="Turn Cities: Skylines saves into printable maps."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="cslmap" Parameters="&quot;%1&quot;">
            <uap:DisplayName>Vellum City Map</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.cslmap</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
